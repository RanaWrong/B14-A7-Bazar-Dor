# ==========================================
# 🛒 বাজার দর (Bazar Dor) — Environment Variables Template
# ==========================================

# 1. BetterAuth Core Configuration
BETTER_AUTH_SECRET=your-32-character-secret-key-here
BETTER_AUTH_URL=https://b14-a7-bazar-dor-blond.vercel.app
NEXT_PUBLIC_APP_URL=https://b14-a7-bazar-dor-blond.vercel.app

# 2. MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bazardor

# 3. Google OAuth / Gmail Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret



# 5. Gmail SMTP Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
